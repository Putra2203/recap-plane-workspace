# Plane API access (Settings -> API Tokens di workspace Plane kamu)
PLANE_API_TOKEN=
PLANE_WORKSPACE_SLUG=
# Plane instance base URL. Untuk Plane Cloud pakai https://api.plane.so,
# untuk self-hosted pakai domain workspace kamu sendiri (mis. https://workspace.namaperusahaan.com)
PLANE_API_BASE_URL=

# Database lokal untuk snapshot & riwayat laporan
DATABASE_URL="file:./dev.db"
