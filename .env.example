# Plane API access (Settings -> API Tokens di workspace Plane kamu)
PLANE_API_TOKEN=
PLANE_WORKSPACE_SLUG=
# Plane instance base URL. Pakai default ini untuk Plane Cloud, atau ganti jika self-hosted.
PLANE_API_BASE_URL=https://api.plane.so

# Database lokal untuk snapshot & riwayat laporan
DATABASE_URL="file:./dev.db"
