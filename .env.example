# Password bersama untuk seluruh tim (bukan per-user) — dipakai untuk login
# ke halaman /login DAN sebagai signing key cookie sesi (lihat src/lib/auth.ts
# untuk alasannya). Wajib diisi, kalau kosong login selalu gagal 500.
APP_PASSWORD=

# Plane API access (Settings -> API Tokens di workspace Plane kamu)
PLANE_API_TOKEN=
PLANE_WORKSPACE_SLUG=
# Plane instance base URL. Untuk Plane Cloud pakai https://api.plane.so,
# untuk self-hosted pakai domain workspace kamu sendiri (mis. https://workspace.namaperusahaan.com)
PLANE_API_BASE_URL=

# Database untuk snapshot & riwayat laporan (Supabase Postgres)
# DATABASE_URL = pooled connection (pgbouncer, port 6543) dipakai runtime app
# DIRECT_URL   = direct connection (port 5432) dipakai saat migrasi schema
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Opsional, hanya relevan kalau deploy ke Vercel: mengunci endpoint
# GET /api/cron/sync (dipanggil oleh Vercel Cron Job, lihat vercel.json) agar
# tidak bisa dipicu sembarang orang yang tahu URL-nya. Isi dengan string
# acak, lalu set env var yang sama persis di Vercel project settings —
# Vercel otomatis mengirim header Authorization: Bearer <nilai ini> di setiap
# pemanggilan cron-nya sendiri. Kalau dikosongkan, endpoint tetap jalan
# tanpa proteksi (startSync() sudah anti-duplikat, jadi risikonya cuma extra
# sync run, bukan corrupt data — tapi lebih baik diisi).
CRON_SECRET=
