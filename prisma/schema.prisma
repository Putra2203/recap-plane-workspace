generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Rekap point bulanan yang sudah dikunci (PRD 15.1.6 / 16 / 18).
// Setelah locked=true, angka tidak berubah lagi walau data Plane berubah.
model MonthlySnapshot {
  id               String   @id @default(cuid())
  period           String // format "2026-09" (YYYY-MM)
  projectId        String
  projectName      String
  // "" = whole-project lock (the only scope the UI offers today); a real
  // cycle id is reserved for a future per-cycle lock. Not nullable on
  // purpose: Postgres does NOT enforce @@unique across NULL values (two
  // NULLs are never considered equal), which would silently defeat the
  // uniqueness this lock's whole guarantee depends on. "" is a real,
  // comparable value, so the constraint below actually holds.
  cycleId          String   @default("")
  memberId         String
  memberName       String
  totalAssignedTask Int
  completedTask    Int
  totalEstimate    Float
  completedEstimate Float
  locked           Boolean  @default(false)
  snapshotDate     DateTime @default(now())

  @@unique([period, projectId, memberId, cycleId])
  @@index([period])
}

// Riwayat laporan yang pernah dibuat (PRD 33.9).
model ReportHistory {
  id          String   @id @default(cuid())
  name        String
  type        String // task | member | project | cycle | module | monthly_point | custom
  filters     String // JSON string
  createdBy   String
  createdAt   DateTime @default(now())
  isSnapshot  Boolean  @default(false) // true = pakai data terkunci, false = live
}

// ---- Mirror tables: synced from Plane so the app never hits Plane's API on
// a normal page load (that's what caused the rate-limit issue). Populated by
// lib/sync.ts, triggered manually via POST /api/sync/run. Every table here
// is fully replaced per project on each sync (delete + createMany), not
// incrementally upserted, so deletions on the Plane side are reflected too.

model Project {
  id           String   @id
  name         String
  identifier   String
  memberCount  Int
  totalCycles  Int
  totalModules Int
  estimateId   String?
  syncedAt     DateTime @default(now())
}

// Global — a person can be a member of several projects.
model Member {
  id          String   @id
  firstName   String
  lastName    String
  email       String
  displayName String
  syncedAt    DateTime @default(now())
}

model ProjectMember {
  projectId String
  memberId  String
  role      Int?

  @@id([projectId, memberId])
  @@index([memberId])
}

model State {
  id        String @id
  projectId String
  name      String
  color     String
  group     String // backlog | unstarted | started | completed | cancelled
  sequence  Float

  @@index([projectId])
}

model Label {
  id        String @id
  projectId String
  name      String
  color     String

  @@index([projectId])
}

model Cycle {
  id              String    @id
  projectId       String
  name            String
  startDate       DateTime?
  endDate         DateTime?
  totalIssues     Int
  completedIssues Int
  cancelledIssues Int
  startedIssues   Int
  unstartedIssues Int
  backlogIssues   Int

  @@index([projectId])
}

model Module {
  id              String @id
  projectId       String
  name            String
  totalIssues     Int
  completedIssues Int

  @@index([projectId])
}

model WorkItem {
  id             String    @id
  projectId      String
  name           String
  sequenceId     Int
  priority       String
  stateId        String
  stateGroup     String // denormalized from State.group for fast filtering
  assignees      String[]
  labels         String[]
  // Raw estimate-system option reference (UUID), kept for debugging/display.
  estimatePoint      String?
  // Resolved via GET .../issues/?expand=estimate_point — Plane returns the
  // scale's actual value (e.g. "8") for that option, which is per-project
  // (the same UUID means a different number in a different project). Null
  // when the item has no estimate assigned, or the scale's value isn't
  // numeric (a text/category scale). See lib/sync.ts.
  estimatePointValue Float?
  point              Int?
  // point ?? estimatePointValue, precomputed at sync time so aggregate
  // queries (groupBy + _sum) can sum this directly instead of pulling every
  // row into Node to merge the two fields in JS. See lib/db-queries.ts.
  effectivePoint Float?
  startDate      DateTime?
  targetDate     DateTime?
  createdAtPlane DateTime
  completedAt    DateTime?
  // Resolved at sync time via /cycles/{id}/cycle-issues/ and
  // /modules/{id}/module-issues/ — not a field Plane exposes on the item.
  cycleId        String?
  moduleIds      String[]

  @@index([projectId])
  @@index([projectId, stateGroup])
  @@index([cycleId])
  @@index([createdAtPlane])
}

model SyncRun {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String // running | success | failed
  projectsSynced  Int       @default(0)
  workItemsSynced Int       @default(0)
  error           String?
}
